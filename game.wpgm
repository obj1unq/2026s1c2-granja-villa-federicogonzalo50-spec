import wollok.game.*
import personaje.*
import cultivos.*
import granja.*

program farmville {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("ground.png")
	const mercadoCentral = new Mercado(position = game.at(2, 2), monedas = 1000)
    const mercadoNorte = new Mercado(position = game.at(7, 8), monedas = 300)

    granja.agregarMercado(mercadoCentral)
    granja.agregarMercado(mercadoNorte)
	//  VISUALES
 	game.addVisualCharacter(personaje)
 	
	// CONTROLES PEDIDOS POR EL EJERCICIO
	keyboard.m().onPressDo({personaje.sembrarMaiz()})
	keyboard.t().onPressDo({personaje.sembrarTrigo()})
	keyboard.o().onPressDo({personaje.sembrarTomaco()})
 	keyboard.r().onPressDo({ personaje.regar() })
	keyboard.c().onPressDo({ granja.cosecharPlanta(personaje.position())})
	keyboard.v().onPressDo({ personaje.venderCosecha() })
	keyboard.space().onPressDo({ personaje.reportarEstado() })
	keyboard.a().onPressDo({ personaje.colocarAspersor() })
 	//  COMIENZA
	game.start()
}
